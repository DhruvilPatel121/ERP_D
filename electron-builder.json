{
  "appId": "com.aaradhana.silver.erp",
  "productName": "Aaradhana Silver ERP",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/dist/**/*",
    "electron/preload.cjs",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/favicon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "asar": false
}
